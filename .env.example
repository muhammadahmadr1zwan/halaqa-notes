# ─────────────── Website (Netlify → Site configuration → Environment variables) ───────────────
APP_PASSWORD=choose-a-password-for-mom      # the only login
SESSION_SECRET=long-random-string           # signs login sessions
WORKER_SECRET=another-long-random-string    # shared with the worker below

# ─────────────── Worker (this file, on the computer that transcribes) ───────────────
API_URL=https://YOUR-SITE.netlify.app
WORKER_SECRET=another-long-random-string    # same value as on Netlify

# Speech-to-text — all free:
#   local = Whisper on this computer (no key, no limits, private)   ← default
#   groq  = Groq's free API (needs GROQ_API_KEY; ~8 audio-hours/day free)
#   elevenlabs = paid, optional
STT_PROVIDER=local
WHISPER_LOCAL_MODEL=large-v3-turbo          # "large-v3" is a bit more accurate but ~4× slower
PYTHON_PATH=worker/.venv/Scripts/python.exe # set by scripts/setup-worker.ps1 (Linux/Mac: worker/.venv/bin/python)

# AI polish (punctuation, Arabic script, headings) + study notes — free keys, no credit card:
#   Gemini: https://aistudio.google.com/apikey   (recommended: big free context)
#   Groq:   https://console.groq.com/keys
LLM_PROVIDER=auto                           # auto | gemini | groq | github | anthropic | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GITHUB_MODELS_TOKEN=                        # optional: a GitHub token with models:read
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Paid, optional
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# YouTube access (only if YouTube blocks downloads)
YTDLP_PATH=worker/.venv/Scripts/yt-dlp.exe  # set by setup script
YTDLP_COOKIES_B64=
YTDLP_PROXY=

# Tuning
CHUNK_MINUTES=20
MAX_DURATION_HOURS=12
REFINE_CONCURRENCY=2
POLL_SECONDS=10
